# anchor-audit environment variables
# Copy this file to .env and fill in the keys for the providers you use.
# You only need one key, set the one that matches your --provider flag.

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini
GEMINI_API_KEY=...

# Groq (free tier available at console.groq.com)
GROQ_API_KEY=gsk_...

# OpenRouter (access 100+ models with one key — openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# Local providers (Ollama, LM Studio, vLLM) do not need an API key.
